<?xml version="1.0" encoding="utf-8"?>
<!--
    CohortHub - Lecturer Student Editor Dialog Layout
    Task 3.1: Student Modification Dialog Layout
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_dialog_editor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:cardBackgroundColor="@color/white">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header Title & Close Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_editor_icon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:src="@drawable/ic_edit_outline"
                    android:contentDescription="@null"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/tv_dialog_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:accessibilityHeading="true"
                    tools:targetApi="28"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/dialog_editor_title"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btn_close_dialog"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_close_dialog"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary" />

            </LinearLayout>

            <TextView
                android:id="@+id/tv_dialog_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/dialog_editor_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Student Name Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_student_name"
                style="@style/CohortHubTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:hint="@string/label_full_name"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_student_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:minHeight="52dp"
                    android:textColor="@color/text_primary"
                    tools:text="Ezekiel Judge" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Student Number Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_student_number"
                style="@style/CohortHubTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/label_student_number"
                app:startIconDrawable="@drawable/ic_badge">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_student_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:maxLength="9"
                    android:minHeight="52dp"
                    android:textColor="@color/text_primary"
                    tools:text="202410125" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Programme Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_programme"
                style="@style/CohortHubDropdownLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/label_programme"
                app:startIconDrawable="@drawable/ic_book">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actv_programme"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:minHeight="52dp"
                    android:textColor="@color/text_primary"
                    tools:text="BSc Computer Science" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Lab Group Dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_lab_group"
                style="@style/CohortHubDropdownLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="@string/label_lab_group"
                app:startIconDrawable="@drawable/ic_group">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actv_lab_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:minHeight="52dp"
                    android:textColor="@color/text_primary"
                    tools:text="G01" />

            </com.google.android.material.textfield.TextInputLayout>

            <!-- Progress Bar -->
            <ProgressBar
                android:id="@+id/progress_saving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Action Buttons Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_cancel"
                    android:textColor="@color/text_secondary"
                    app:strokeColor="@color/outline" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    style="@style/CohortHubPrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:text="@string/btn_save_changes" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</com.google.android.material.card.MaterialCardView>
