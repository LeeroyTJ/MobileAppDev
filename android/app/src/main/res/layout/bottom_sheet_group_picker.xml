<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/surface">

    <TextView
        android:id="@+id/tvPickerTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Lab Group"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/text_primary"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Maximum capacity is 15 students per group."
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/text_secondary" />

    <!-- Group Options List -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- G01 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGroupG01"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lab Group G01"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvG01Occupancy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / --"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/dodger_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- G02 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGroupG02"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lab Group G02"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvG02Occupancy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / --"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/dodger_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- G03 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGroupG03"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lab Group G03"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvG03Occupancy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / --"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/dodger_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- G04 -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGroupG04"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clickable="true"
            android:focusable="true"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/outline"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Lab Group G04"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:id="@+id/tvG04Occupancy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / --"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="@color/dodger_blue" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelPicker"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginTop="12dp"
        android:text="@string/btn_cancel" />

</LinearLayout>
