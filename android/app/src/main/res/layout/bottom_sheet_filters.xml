<?xml version="1.0" encoding="utf-8"?>

<!--
    LabNexa
    Filter & Search Bottom Sheet

    Used from the Lecturer Roster (opened by @id/button_open_filters).

    Filters:
    - Programme
    - Lab group, including Unassigned
    - Local synchronization status

    Dropdowns map 1:1 to RosterViewModel: programmeFilter, groupFilter, statusFilter.
    Position 0 of every dropdown is "All" (= no filter).

    The screen is UI-only at this stage.
    Java/ViewModel logic will be added later.
    Requires Material Components 1.10+ (colorSurfaceContainer).
-->

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/filter_sheet_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- ========================================================= -->
        <!-- HEADER                                                     -->
        <!-- ========================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/sheet_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:text="@string/filter_sheet_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sheet_button_clear"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:text="@string/filter_sheet_clear"
                android:textColor="?attr/colorPrimary" />

        </LinearLayout>


        <!-- ========================================================= -->
        <!-- PROGRAMME                                                  -->
        <!-- ========================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_programme"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/filter_label_programme">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdown_programme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="52dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                tools:text="All" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================================= -->
        <!-- LAB GROUP                                                  -->
        <!-- ========================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_group"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/filter_label_group">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdown_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="52dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                tools:text="All" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================================= -->
        <!-- SYNC STATUS (local only: the API has no status filter)     -->
        <!-- ========================================================= -->

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_status"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/filter_label_status"
            app:helperText="@string/filter_status_helper">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/dropdown_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="52dp"
                android:textColor="?attr/colorOnSurface"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                tools:text="All" />

        </com.google.android.material.textfield.TextInputLayout>


        <!-- ========================================================= -->
        <!-- RESULT SUMMARY                                             -->
        <!-- Live count. Use plurals filter_result_count with           -->
        <!-- studentsFound. Live region: TalkBack announces changes.    -->
        <!-- ========================================================= -->

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/filter_result_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/filter_result_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/filter_result_title"
                    android:textAppearance="?attr/textAppearanceLabelLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/filter_result_count"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:accessibilityLiveRegion="polite"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="8 students match your filters" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ========================================================= -->
        <!-- APPLY BUTTON (closes the sheet; filters are already live)  -->
        <!-- ========================================================= -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/sheet_button_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="56dp"
            android:text="@string/filter_apply" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>